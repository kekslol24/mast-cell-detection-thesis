    "#| label: fig-correlation-p5a\n",
    "#| fig-cap: 'Correlation of P5-A 35-fold LOPO: mAP50 against ground-truth cell counts. Marked points are below the threshold of 0.820.'\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
