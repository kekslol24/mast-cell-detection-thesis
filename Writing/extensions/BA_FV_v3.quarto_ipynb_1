    "    (1,\"P1\",482,2,0.813),(2,\"P10\",5,20,0.991),(3,\"P11\",17,20,0.964),(4,\"P12\",133,0,0.984),\n",
    "    (5,\"P13\",0,7,0.995),(6,\"P14\",5,3,0.995),(7,\"P15\",0,68,0.991),(8,\"P16\",22,1,0.994),\n",
    "    (9,\"P17\",69,0,0.992),(10,\"P18\",81,1,0.993),(11,\"P2\",449,6,0.716),(12,\"P24\",1,0,0.995),\n",
    "    (13,\"P28\",1,0,0.995),(14,\"P29\",1,0,0.995),(15,\"P3\",60,4,0.906),(16,\"P31\",0,1,0.995),\n",
    "    (17,\"P37\",0,2,0.995),(18,\"P39\",0,1,0.995),(19,\"P4\",122,6,0.806),(20,\"P40\",0,1,0.995),\n",
