   "source": [
    "#| label: fig-p5p6-comparison\n",
    "#| fig-cap: Performance comparison across P5-A (35-fold LOPO, test), P5-B (5-group CV, test), and P6-A (final model, val). Error bars show ±1 std across folds, clipped at 1.0. P6-A is a single training run with no held-out test set.\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "p5a_df = pd.read_csv(\"../../hpc/yolo_new_v4_freeze10_copy/fold_results_eval.csv\")\n",
    "p5b_df = pd.read_csv(\"../../hpc/yolo_new_v4_freeze10_re_run_CV/fold_results.csv\")\n",
    "\n",
    "# mAP50, mAP50-95, Precision, Recall — match the metrics list order below\n",
    "cols = [\"Test_mAP50\", \"Test_mAP50-95\", \"Test_Precision\", \"Test_Recall\"]\n",
    "\n",
    "p5a_vals = np.array([p5a_df[c].mean() for c in cols])\n",
    "p5a_errs = np.array([p5a_df[c].std()  for c in cols])\n",
    "p5b_vals = np.array([p5b_df[c].mean() for c in cols])\n",
    "p5b_errs = np.array([p5b_df[c].std()  for c in cols])\n",
    "\n",
    "metrics = [\"mAP50\", \"mAP50-95\", \"Precision\", \"Recall\"]\n",
    "\n",
    "means = {\n",
    "    \"P5-A (35f-LOPO)\":   p5a_vals,\n",
    "    \"P5-B (5-group CV)\":  p5b_vals,\n",
    "    \"P6-A (final, val)\":  np.array([0.941, 0.842, 0.906, 0.921]),\n",
    "}\n",
    "stds = {\n",
    "    \"P5-A (35f-LOPO)\":   p5a_errs,\n",
    "    \"P5-B (5-group CV)\":  p5b_errs,\n",
    "    \"P6-A (final, val)\":  np.array([0, 0, 0, 0]),\n",
    "}\n",
    "colors = [\"#4C72B0\", \"#DD8452\", \"#55A868\"]\n",
    "\n",
    "x = np.arange(len(metrics))\n",
    "w = 0.25\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
