    "ax.set_xticklabels(metrics)\n",
    "ax.set_ylim(0.5, 1.08)\n",
    "ax.set_ylabel(\"Score\")\n",
    "ax.set_title(\"P5-A / P5-B / P6-A Metric Comparison\")\n",
