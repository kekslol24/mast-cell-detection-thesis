    "#| label: fig-p5p6-comparison\n",
    "#| fig-cap: Performance comparison across P5-A , P5-B, and P6-A. Error bars show std across folds, clipped at 1.0.\n",
    "#| out-width: 100%\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "p5a_df = pd.read_csv(\"../../hpc/jobs/slurm_jobs&projects/projects_dir/yolo_new_v4_freeze10_copy/fold_results_eval.csv\")\n",
    "p5b_df = pd.read_csv(\"../../hpc/jobs/slurm_jobs&projects/projects_dir/yolo_new_v4_freeze10_re_run_CV/fold_results.csv\")\n",
    "\n",
    "# mAP50, mAP50-95, Precision, Recall — match the metrics list order below\n",
    "cols = [\"Test_mAP50\", \"Test_mAP50-95\", \"Test_Precision\", \"Test_Recall\", \"Test_Recall_Atypisch\", \"Test_Recall_Normal\"]\n",
    "\n",
    "p5a_vals = np.array([p5a_df[c].mean() for c in cols])\n",
    "p5a_errs = np.array([p5a_df[c].std()  for c in cols])\n",
    "p5b_vals = np.array([p5b_df[c].mean() for c in cols])\n",
    "p5b_errs = np.array([p5b_df[c].std()  for c in cols])\n",
    "\n",
    "metrics = [\"mAP50\", \"mAP50-95\", \"Precision\", \"Recall\", \"Recall_atypical\", \"Recall_normal\"]\n",
    "\n",
    "means = {\n",
    "    \"P5-A (35f-LOPO)\":   p5a_vals,\n",
    "    \"P5-B (5-group CV)\":  p5b_vals,\n",
    "    \"P6-A (final, val)\":  np.array([0.941, 0.842, 0.906, 0.921, 0.914, 0.929]),\n",
    "}\n",
    "stds = {\n",
    "    \"P5-A (35f-LOPO)\":   p5a_errs,\n",
    "    \"P5-B (5-group CV)\":  p5b_errs,\n",
    "    \"P6-A (final, val)\":  np.array([0, 0, 0, 0, 0, 0]),\n",
    "}\n",
    "colors = [\"#4C72B0\", \"#DD8452\", \"#55A868\"]\n",
    "\n",
    "x = np.arange(len(metrics))\n",
    "w = 0.25\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4.5))\n",
    "w = 0.27\n",
    "for i, (label, color) in enumerate(zip(means.keys(), colors)):\n",
    "    m = means[label]; s = stds[label]\n",
    "    err_up = np.minimum(s, 1.0 - np.asarray(m))\n",
    "    centers = x + (i - 1) * w\n",
    "    ax.bar(centers, m, w, label=label, color=color, alpha=0.85,\n",
    "           yerr=[s, err_up], capsize=4, error_kw={\"linewidth\": 1})\n",
    "    label_means(ax, centers, m, err_up)\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels([\"mAP50\", \"mAP50-95\", \"Precision\", \"Recall\", \"$R_\\mathrm{{atypical}}$\", \"$R_\\\\mathrm{{normal}}$\"])\n",
    "ax.set_ylim(0, 1.35)\n",
    "ax.set_ylabel(\"Score\")\n",
    "ax.set_title(\"P5-A / P5-B / P6-A Metric Comparison\")\n",
    "ax.axhline(1.0, color=\"gray\", linestyle=\":\", linewidth=0.8)\n",
    "ax.legend(loc=\"lower right\")\n",
    "plt.tight_layout(); plt.show()"
