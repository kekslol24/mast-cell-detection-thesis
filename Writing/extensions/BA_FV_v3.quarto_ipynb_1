   "source": [
    "#| label: fig-p5a-vs-p5b\n",
    "#| fig-cap: Metric comparison between P5-A (35-fold LOPO) and P5-B (grouped 5-fold CV). Error bars represent ±1 standard deviation across folds. R_Atyp and R_Norm for P5-A are computed over the 20 and 29 folds respectively where the class was present in the test set.\n",
    "#| out-width: 100%\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"font.size\": 12, \"axes.titlesize\": 15, \"axes.labelsize\": 14,\n",
    "    \"xtick.labelsize\": 13, \"ytick.labelsize\": 12, \"legend.fontsize\": 12,\n",
    "})\n",
    "\n",
    "def label_means(ax, centers, means, errs_up, fontsize=12):\n",
    "    # mean printed above the error-bar cap, vertical so it never runs off the edge\n",
    "    for cx, m, eu in zip(centers, means, errs_up):\n",
    "        ax.text(cx, m + eu + 0.02, f\"{m:.3f}\",\n",
    "                ha=\"left\", va=\"bottom\", rotation=45,\n",
    "                fontsize=fontsize, color=\"black\", rotation_mode=\"anchor\")\n",
    "\n",
    "p5a_df = pd.read_csv(\"../../hpc/jobs/slurm_jobs&projects/projects_dir/yolo_new_v4_freeze10_copy/fold_results_eval.csv\")\n",
