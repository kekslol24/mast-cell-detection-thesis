   "source": [
    "#| label: fig-p5b-recall\n",
    "#| fig-cap: P5-B per-group recall by class. Bars show $R_\\mathrm{atypical}$ (blue) and $R_\\mathrm{{normal}}$ (orange) for each held-out patient group. Dashed horizontal lines mark the cross-fold means ($R_\\mathrm{atypical}$ = 0.885, $R_\\mathrm{{normal}}$ = 0.821).\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "groups   = [\"G1\", \"G2\", \"G3\", \"G4\", \"G5\"]\n",
    "r_atyp   = [0.904, 0.836, 0.884, 0.928, 0.873]\n",
    "r_norm   = [0.588, 0.710, 0.981, 0.909, 0.918]\n",
    "mean_a, mean_n = 0.885, 0.821\n",
    "\n",
    "x = np.arange(len(groups))\n",
    "w = 0.35\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6, 3.5))\n",
    "ax.bar(x - w/2, r_atyp, w, label=\"$R_\\\\mathrm{atypical}$\", color=\"#4C72B0\")\n",
    "ax.bar(x + w/2, r_norm,  w, label=\"$R_\\\\mathrm{{normal}}$\",   color=\"#DD8452\")\n",
    "ax.axhline(mean_a, color=\"#4C72B0\", linestyle=\"--\", linewidth=1, label=fr\"Mean $R_\\mathrm{{atypical}}$ ({mean_a:.3f})\")\n",
    "ax.axhline(mean_n, color=\"#DD8452\", linestyle=\"--\", linewidth=1, label=fr\"Mean $R_\\mathrm{{normal}}$ ({mean_n:.3f})\")\n",
    "for xi, (va, vn) in enumerate(zip(r_atyp, r_norm)):\n",
    "    ax.text(xi - w/2, va + 0.01, f\"{va:.3f}\", ha='center', va='bottom', fontsize=7)\n",
    "    ax.text(xi + w/2, vn + 0.01, f\"{vn:.3f}\", ha='center', va='bottom', fontsize=7)\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(groups)\n",
    "ax.set_ylim(0, 1.12)\n",
    "ax.set_ylabel(\"Recall\")\n",
    "ax.legend(fontsize=8, loc=\"lower right\")\n",
    "ax.set_title(\"Recall across Folds\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
