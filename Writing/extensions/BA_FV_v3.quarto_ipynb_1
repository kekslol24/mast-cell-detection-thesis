    "    (25,\"P47\",0,3,0.995),(26,\"P48\",7,0,0.995),(27,\"P5\",3,18,0.760),(28,\"P50\",0,1,0.995),\n",
    "    (29,\"P51\",5,90,0.765),(30,\"P52\",1,4,0.995),(31,\"P53\",0,5,0.995),(32,\"P6\",0,6,0.995),\n",
    "    (33,\"P7\",8,12,0.975),(34,\"P8\",0,24,0.986),(35,\"P9\",4,195,0.622),\n",
    "]\n",
    "patient = [d[1] for d in DATA]\n",
    "atyp  = np.array([d[2] for d in DATA], float)\n",
    "norm  = np.array([d[3] for d in DATA], float)\n",
    "total = atyp + norm\n",
    "mAP   = np.array([d[4] for d in DATA], float)\n",
    "\n",
    "preds = [(\"GT atypical cells (held-out patient)\", atyp),\n",
    "         (\"GT normal cells (held-out patient)\", norm),\n",
    "         (\"Total GT cells (held-out patient)\", total)]\n",
